<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ShopManager</AssemblyName>
    <RootNamespace>ShopManager</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <UseWindowsForms>False</UseWindowsForms>
    <Version>1.0.24</Version>
    <!-- 套件附帶的 API 說明 XML 只給 IDE 用，執行時用不到，不必打包進安裝檔 -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ShopManager.Tests\**\*" />
    <None Remove="ShopManager.Tests\**\*" />
    <Content Remove="ShopManager.Tests\**\*" />
    <EmbeddedResource Remove="ShopManager.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\logo.png" />
    <EmbeddedResource Include="Resources\banks.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4218" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.75.0.4225" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />

    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />

    <PackageReference Include="PDFsharp" Version="6.2.4" />

    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- EF Core Sqlite 帶入的 2.1.11 有已知高嚴重性弱點（GHSA-2m69-gcr7-jv3q），明確升到修補版 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />

  </ItemGroup>


  <Target Name="PackageInstaller" AfterTargets="Publish" Condition="'$(IsReleaseBuild)' == 'true'">
    <Exec Command="powershell -ExecutionPolicy Bypass -NonInteractive -File &quot;$(MSBuildProjectDirectory)\publish.ps1&quot; -Version $(Version) -SkipDotnetPublish" />
  </Target>

</Project>
