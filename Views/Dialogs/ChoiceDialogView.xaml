<UserControl x:Class="ShopManager.Views.Dialogs.ChoiceDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="360" MaxWidth="520">

    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24,20,24,12">
        <StackPanel>

            <TextBlock x:Name="TitleText"
                       FontSize="{DynamicResource FontSizeDialogTitle}" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="ContentText"
                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource AppSubtleForegroundBrush}"
                       TextWrapping="Wrap"
                       Opacity="0.87"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,0,4,0"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="cancel"/>

                <!-- 次要動作（多為破壞性，紅字） -->
                <Button x:Name="SecondaryBtn"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        Margin="0,0,4,0"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="secondary"/>

                <Button x:Name="PrimaryBtn"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="primary"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
