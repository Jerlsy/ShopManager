<Window x:Class="ShopManager.Views.Dialogs.IchefDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="從 iCHEF 下載打卡資料"
        Width="900" Height="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource FontSizeBody}"
        Background="{DynamicResource AppShellBackgroundBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 進度：標題＋步驟＋進度條 -->
        <Border Grid.Row="0" Padding="24,18,24,16" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <md:PackIcon Kind="CloudDownloadOutline" Width="24" Height="24"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="HeaderText" FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSizeSubTitle}"/>
                        <TextBlock x:Name="SubText" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="{Binding Icon}" Width="18" Height="18"
                                             Foreground="{Binding IconBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                    <Run Text="{Binding Detail, Mode=OneWay}"
                                         Foreground="{DynamicResource AppSubtleForegroundBrush}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,12,0,0"/>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextStyle}"/>
            </StackPanel>
        </Border>

        <!-- 登入提醒（登入完成後收起） -->
        <Border x:Name="LoginBanner" Grid.Row="1" Padding="24,10"
                Background="{DynamicResource AppPanelAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,0,8,0"
                             Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- iCHEF 後台（只用來登入；登入後自動收起） -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="2"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource MaterialDesignFlatButton}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
