<Window x:Class="ShopManager.Views.Dialogs.GmailDeployGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Google Apps Script 部署指南" Width="720" Height="720"
        WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppSurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <md:PackIcon Kind="ScriptTextOutline" Width="22" Height="22" Margin="0,0,8,0"
                         Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Google Apps Script 部署指南" FontWeight="Medium" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" FontSize="13">
                    <Run Text="1. 開啟"/>
                    <Run Text="https://script.google.com/" FontFamily="Consolas"/>
                    <Run Text="，建立新專案。"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="2. 刪除預設內容，貼上下方的完整程式碼。"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="3. 左側「專案設定」→「指令碼屬性」，新增一筆鍵名 CONFIG_FILE_ID，值貼上下面這個 File ID："/>
                </TextBlock>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ConfigFileIdText" Grid.Column="0" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="32" Padding="10,0" Click="CopyFileId_Click">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="複製" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" FontSize="13">
                    <Run Text="4. 在編輯器上方函式選單選擇 setupTriggers，按執行。第一次執行會跳出 Google 帳號授權畫面，"/>
                    <Run Text="請選擇跟 ShopManager 綁定的同一個 Google 帳號並同意權限。畫面可能顯示「Google 尚未驗證這個應用程式」，"/>
                    <Run Text="這是正常的，點選「進階」→「前往(專案名稱)」即可繼續。"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="5. 執行成功後，回到 ShopManager 按「檢查部署狀態」。兩個服務要各自被觸發過一次才會顯示正常，"/>
                    <Run Text="setupTriggers 只是建立排程，實際第一次執行請等待最多 5～10 分鐘。"/>
                </TextBlock>

                <Grid Margin="0,4,0,8">
                    <TextBlock Text="完整程式碼" FontWeight="Medium" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="32" Padding="10,0" Click="CopyCode_Click">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="複製程式碼" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <TextBox x:Name="CodeText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="11.5" Padding="10"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Height="300" Background="{DynamicResource AppPanelAltBrush}" BorderThickness="0"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="關閉" Style="{StaticResource MaterialDesignRaisedButton}"
                Width="120" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click"/>
    </Grid>
</Window>
