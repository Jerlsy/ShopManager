<Window x:Class="ShopManager.Views.Schedule.IbonPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ibon 雲端列印"
        Width="520" Height="560"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppShellBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 標題與說明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <md:PackIcon Kind="CloudPrintOutline" Width="22" Height="22" Margin="0,0,8,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="上傳至 ibon 雲端列印" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                       Text="勾選要上傳的班表，完成後系統會將取件列印碼與 QR Code 推播至業主 LINE。至全台 7-11 ibon 機台選「列印」→「雲端列印」輸入列印碼即可列印（效期 3 天）。"/>
        </StackPanel>

        <!-- 勾選項目 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <CheckBox x:Name="ChkFull" IsChecked="True" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="完整班表" FontWeight="SemiBold"/>
                    <TextBlock Text="上半月＋下半月共 2 頁（A4 橫式 PDF，一組列印碼）"
                               Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="ChkPersonal" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="全體個人班表" FontWeight="SemiBold"/>
                    <TextBlock Text="每 3 位員工排一頁（A4 橫式 PDF，一組列印碼）"
                               Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>

        <!-- 操作與進度 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UploadButton" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Upload_Click">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CloudUploadOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="上傳並推播列印碼"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="8,0,0,0" Click="Close_Click">
                    <TextBlock Text="關閉"/>
                </Button>
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="Collapsed">
                <ProgressBar x:Name="ProgressBarCtrl" Width="180" Height="6" IsIndeterminate="True"/>
                <TextBlock x:Name="StatusText" Margin="10,0,0,0" FontSize="12"
                           Foreground="{DynamicResource AppSubtleTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- 上傳結果（列印碼 + QR）-->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
