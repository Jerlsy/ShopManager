<Window x:Class="ShopManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopManager" Width="380" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Resources/app.ico"
        Background="#1E1E2E">
    <Border BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Resources/logo.png" Width="56" Height="56" Margin="0,0,0,10"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="ShopManager" FontSize="24" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="排班／薪資管理系統" FontSize="12"
                       Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,22"/>
            <ProgressBar IsIndeterminate="True" Width="220" Height="4" BorderThickness="0"
                         Foreground="#4A90D9" Background="#333344"/>
            <TextBlock x:Name="StatusText" Text="正在啟動…" FontSize="12"
                       Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
