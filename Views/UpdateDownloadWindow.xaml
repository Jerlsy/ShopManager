<Window x:Class="ShopManager.Views.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="軟體更新" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBrush}">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <md:PackIcon Kind="Download" Width="20" Height="20" Margin="0,0,8,0"
                         Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="正在下載更新，請稍候…" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
        <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="1" Value="0"/>
        <TextBlock x:Name="DownloadProgressText" Margin="0,10,0,0" FontSize="12"
                   Foreground="{DynamicResource AppSubtleTextBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
