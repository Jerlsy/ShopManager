<UserControl x:Class="ShopManager.Views.SalarySettings.SalarySettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ShopManager.Helpers"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:ShopManager.Models">

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <helpers:ShadowBorder Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0"
                            Visibility="{Binding DataContext.ShopLogoData, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}">
                        <Image Source="{Binding DataContext.ShopLogoData, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BytesToImageConverter}}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="薪資設定" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="32"
                            Margin="0,0,12,0"
                            Command="{Binding OpenLaborLawCommand}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileAccount" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="勞基法設定"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="32"
                            Command="{Binding StartNewCommand}"
                            Visibility="{Binding ShowLaborLaw, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="新增薪資方案"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </helpers:ShadowBorder>

        <Grid Grid.Row="1">

            <!-- ── 卡片模式（未展開編輯）：仿員工資料管理，全區展開 ── -->
            <helpers:ShadowBorder Style="{StaticResource SectionCardStyle}"
                    Visibility="{Binding ShowListCards, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <!-- 無資料提示 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibilityConverter}}">
                        <md:PackIcon Kind="CurrencyUsd" Width="60" Height="60" Opacity="0.12" HorizontalAlignment="Center"/>
                        <TextBlock Text="尚未新增任何薪資方案，點選右上角「新增薪資方案」開始"
                                   Margin="0,14,0,0" Opacity="0.45"
                                   Style="{StaticResource ItemTitleStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 薪資方案卡片清單 -->
                    <ItemsControl ItemsSource="{Binding Salaries}" Margin="0,0,0,8"
                                  Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{DynamicResource LayoutEmployeeCardWidth}" Margin="0,0,12,12"
                                        Style="{StaticResource ItemCardStyle}" Padding="16,14" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <!-- 刪除按鈕（右上角） -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="30" Height="30"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-6,-8,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="刪除薪資方案">
                                            <md:PackIcon Kind="DeleteOutline" Width="15" Height="15" Opacity="0.45"/>
                                        </Button>

                                        <StackPanel Margin="0,0,30,0">
                                            <TextBlock Text="{Binding Alias}" Style="{StaticResource ItemTitleStyle}"/>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource SalaryTypeDisplayConverter}}"
                                                       Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </helpers:ShadowBorder>

            <!-- ── 清單 + 編輯模式（展開編輯 / 勞基法設定，共用同一區塊） ── -->
            <Grid Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource LayoutSideListGridWidth}"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 窄版薪資列表 -->
                <helpers:ShadowBorder Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="方案清單" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox ItemsSource="{Binding Salaries}"
                             SelectedItem="{Binding SelectedSalary}"
                             Style="{StaticResource MaterialDesignListBox}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="20">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Alias}" Style="{StaticResource ItemTitleStyle}"
                                                   FontSize="{DynamicResource FontSizeSmallBody}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource SalaryTypeDisplayConverter}}"
                                                   Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0"/>

                                        <!-- 備註 + 編輯/刪除按鈕（右下） -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Description}"
                                                       VerticalAlignment="Bottom"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="26" Height="26" Padding="0" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="26" Height="26" Padding="0"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </helpers:ShadowBorder>

            <!-- 右側詳細面板：薪資編輯表單 / 勞基法設定，二者互斥顯示，填滿整個欄位高度，內容過長時可滾動 -->
            <Grid Grid.Column="2">

                <!-- 薪資編輯表單 -->
                <helpers:ShadowBorder Style="{StaticResource EditFormCardStyle}" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Padding="0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSalary, Converter={StaticResource NullToStringConverter}, ConverterParameter='新增薪資方案|編輯薪資方案'}"
                                       FontSize="{DynamicResource FontSizeListTitle}" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="薪資方案名稱 *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding EditAlias, UpdateSourceTrigger=PropertyChanged}"
                                    
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="方案說明 (備註)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                    
                                     Margin="0,0,0,20"
                                     AcceptsReturn="True" MinHeight="60" VerticalContentAlignment="Top"/>

                            <TextBlock Text="薪資類型" Style="{StaticResource FormSectionStyle}"/>
                            <ComboBox ItemsSource="{Binding SalaryTypes}"
                                      SelectedItem="{Binding EditType}"
                                     
                                      md:HintAssist.Hint="選擇類型"
                                      Margin="0,0,0,20">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SalaryTypeDisplayConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 動態輸入項 -->
                            <Border Style="{StaticResource ItemCardStyle}" Margin="0,0,0,20" Padding="16,12">
                                <Grid>
                                    <!-- 時薪 -->
                                    <StackPanel Visibility="{Binding EditType, Converter={StaticResource SalaryTypeVisibilityConverter}, ConverterParameter=Hourly}">
                                        <TextBlock Text="時薪 (元) *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding EditHourlyRate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                 md:HintAssist.Hint="可建立多個方案分別對應平日/假日"/>
                                    </StackPanel>
                                    <!-- 月薪 -->
                                    <StackPanel Visibility="{Binding EditType, Converter={StaticResource SalaryTypeVisibilityConverter}, ConverterParameter=Monthly}">
                                        <TextBlock Text="月薪底薪 (元) *" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding EditMonthlyBase, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 加班設定 Expander -->
                            <Expander Header="自訂加班計算設定 (選填，不填則套用勞基法)"
                                      Style="{StaticResource MaterialDesignExpander}"
                                      Margin="0,0,0,24"
                                      Background="{DynamicResource AppPanelBrush}">
                                <StackPanel Margin="16,8,16,8">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="加班費倍率 1 (×)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditOT1Rate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="加班費倍率 2 (×)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditOT2Rate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="假日加班倍率 (×)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditHolidayRate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="每日最長工時 (小時)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditDailyMaxHours, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="每週最長工時 (小時)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditWeeklyMaxHours, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,12,0"
                                        Command="{Binding SaveCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="儲存方案"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="取消"
                                        Width="100"
                                        Command="{Binding CancelCommand}"/>
                            </StackPanel>
                        </StackPanel>
                </ScrollViewer>
                    </helpers:ShadowBorder>

                <!-- 勞基法設定：與薪資編輯表單共用同一右側面板區塊，內容維持易讀寬度並可滾動 -->
                <helpers:ShadowBorder Style="{StaticResource EditFormCardStyle}" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Padding="0"
                        Visibility="{Binding ShowLaborLaw, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                <Border Style="{StaticResource InfoBoxStyle}" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="InformationOutline" Width="24" Height="24" Foreground="{DynamicResource AppInfoForegroundBrush}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <TextBlock Text="以下數值僅供系統自動計算薪資時參考，請定期檢查並確保符合勞動部最新公告。"
                                   TextWrapping="Wrap" Style="{StaticResource PageTitleStyle}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource AppInfoForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <Expander Header="時薪人員標準" IsExpanded="True" Style="{StaticResource MaterialDesignExpander}" Margin="0,0,0,16">
                            <StackPanel Margin="16,8,16,8">
                                <TextBlock Text="法定最低時薪 (元)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.HourlyMinimumWage}" Margin="0,0,0,16"/>
                                <TextBlock Text="加班倍率 1（第 2 小時起）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.HourlyOT1Rate}" Margin="0,0,0,16"/>
                                <TextBlock Text="加班倍率 2（第 3 小時起）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.HourlyOT2Rate}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Expander Header="月薪人員標準" IsExpanded="True" Style="{StaticResource MaterialDesignExpander}" Margin="0,0,0,16">
                            <StackPanel Margin="16,8,16,8">
                                <TextBlock Text="法定最低月薪 (元)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.MonthlyMinimumWage}" Margin="0,0,0,16"/>
                                <TextBlock Text="加班倍率 1（第 2 小時起）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.MonthlyOT1Rate}" Margin="0,0,0,16"/>
                                <TextBlock Text="加班倍率 2（第 3 小時起）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.MonthlyOT2Rate}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>

                <Expander Header="通用限制設定" IsExpanded="True" Style="{StaticResource MaterialDesignExpander}" Margin="0,0,0,24">
                    <StackPanel Margin="16,8,16,8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="假日加班費率 (×)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.HolidayOTRate}" Margin="0,0,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每月加班時數上限 (小時)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.MaxMonthlyOTHours}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="每日正常工時 (小時)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.DailyNormalHours}" Margin="0,0,0,8"
                                         md:HintAssist.Hint="加班起算基準，預設8小時"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每日最長工時 (小時)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.DailyMaxHours}" Margin="0,0,0,8"
                                         md:HintAssist.Hint="含加班上限，預設12小時"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="每週最長工時 (小時)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.WeeklyMaxHours}" Margin="0,0,0,8"
                                         md:HintAssist.Hint="每週工時上限，預設40小時"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最長連續上班日數 (天)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding LaborLaw.MaxConsecutiveWorkDays}" Margin="0,0,0,8"
                                         md:HintAssist.Hint="勞基法第36條，預設6天"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0" Command="{Binding SaveLaborLawCommand}">
                        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="儲存勞基法設定"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="返回薪資列表" Width="140" Command="{Binding CloseLaborLawCommand}"/>
                </StackPanel>
        </StackPanel>
        </ScrollViewer>
        </helpers:ShadowBorder>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>